<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr">

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <xacro:arg name="robot_name" default="amr"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="use_webots" default="false"/>

    <xacro:include filename="$(find amr_description)/urdf/mech/base.urdf.xacro"/>
    <xacro:include filename="$(find amr_description)/urdf/mech/wheel.urdf.xacro"/>
    <xacro:include filename="$(find amr_description)/urdf/sensors/camera.urdf.xacro"/>
    <xacro:include filename="$(find amr_description)/urdf/sensors/lidar.urdf.xacro"/>
    <xacro:include filename="$(find amr_description)/urdf/sensors/imu.urdf.xacro"/>

    <xacro:base prefix="$(arg prefix)"/>

    <xacro:wheel
      prefix="$(arg prefix)"
      side="left"
      y_reflect="1"/>

    <xacro:wheel
      prefix="$(arg prefix)"
      side="right"
      y_reflect="-1"/>

    <xacro:camera
      prefix="$(arg prefix)"
      camera_name="cam_1"
      xyz_offset="0.105 0 0.05"
      rpy_offset="0 0 0"/>

    <!-- Originally z=0.22, sized against the old 280x220x150mm mecanum
         chassis (top at z=0.1905) - a 0.0295m clearance margin above the
         chassis roof to clear a self-collision blind spot (see
         decisions-and-gotchas.md). Left unchanged when the 2WD+caster
         transition first landed, which left the lidar visibly floating
         with a large gap above the new, much shorter chassis (top at
         z=0.1175, see base.urdf.xacro) - confirmed visually in Webots/RViz.
         Recomputed here with the SAME 0.0295m margin against the new
         chassis top (0.1175 + 0.0295 = 0.1470, rounded to 0.15) rather than
         reusing the old absolute height, closing the gap while keeping the
         original design intent (small positive clearance, not flush). -->
    <xacro:lidar
      prefix="$(arg prefix)"
      parent="base_link"
      frame_id="laser_frame"
      xyz_offset="0 0 0.15"
      rpy_offset="0 0 0"
      mesh_xyz_offset="0 0 0"
      mesh_rpy_offset="${-M_PI/2} 0 0"
      min_range="0.05"
      topic_name="scan"/>

    <xacro:imu
      prefix="$(arg prefix)"
      frame_id="imu"
      xyz_offset="0 0 0.006"
      rpy_offset="0 0 0"
      update_rate="15.0"
      topic_name="imu/data"/>

    <xacro:include filename="$(find amr_description)/urdf/control/velocity_control.urdf.xacro" />
    <xacro:load_velocity_control use_gazebo="$(arg use_gazebo)"/>

    <xacro:include filename="$(find amr_description)/urdf/control/sim_control.urdf.xacro" />
    <xacro:load_sim_control
      robot_name="$(arg robot_name)"
      use_gazebo="$(arg use_gazebo)"/>

    <xacro:include filename="$(find amr_description)/urdf/control/ros2_control.urdf.xacro" />
    <xacro:amr_ros2_control
      prefix="$(arg prefix)"
      use_gazebo="$(arg use_gazebo)"
      use_webots="$(arg use_webots)"/>

</robot>
