WorldInfo {
  basicTimeStep 20
  contactProperties [
    ContactProperties {
      material1 "rubber"
      coulombFriction [
        2.5
      ]
    }
    # wheel_material: plain differential-drive wheel, both left/right share
    # this one material - no frictionRotation split needed since these are
    # ordinary single-axis rolling wheels, not angled mecanum rollers.
    # coulombFriction matches wheel.urdf.xacro's Gazebo-path mu1/mu2 (0.8)
    # for parity between the two friction declarations.
    ContactProperties {
      material1 "wheel_material"
      material2 "default"
      coulombFriction [
        0.8
      ]
      softCFM 0.00001
      softERP 0.8
    }
    # caster_material: near-zero friction per the task's directive
    # (mu1=mu2=0.001) - the caster is a fixed (non-swiveling) joint, so low
    # friction is what lets it slide freely as the diff-drive wheels steer,
    # standing in for a real caster's free-swivel DOF.
    ContactProperties {
      material1 "caster_material"
      material2 "default"
      coulombFriction [
        0.001
      ]
      softCFM 0.00001
      softERP 0.8
    }
  ]
}
