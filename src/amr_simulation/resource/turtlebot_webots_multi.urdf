<?xml version="1.0" ?>
<!--
  Two-robot variant of turtlebot_webots.urdf: identical devices, but every topicName is RELATIVE
  (scan, imu, ultrasonic/*), so it resolves under each driver node's namespace (/amr1/scan,
  /amr2/scan, ...). The single-robot file (absolute /scan ...) is untouched. The PluginExample
  python plugin of the original is dropped (unused).
-->
<robot name="TurtleBot3 Burger Webots">
    <webots>
        <device reference="LDS-01" type="Lidar">
            <ros>
                <enabled>true</enabled>
                <updateRate>5</updateRate>
                <topicName>scan</topicName>
                <alwaysOn>false</alwaysOn>
                <frameName>LDS-01</frameName>
            </ros>
        </device>

        <plugin type="webots_ros2_driver::Ros2IMU">
            <enabled>true</enabled>
            <updateRate>20</updateRate>
            <topicName>imu</topicName>
            <alwaysOn>false</alwaysOn>
            <frameName>imu_link</frameName>
            <inertialUnitName>inertial_unit</inertialUnitName>
            <gyroName>gyro</gyroName>
            <accelerometerName>accelerometer</accelerometerName>
        </plugin>

        <plugin type="webots_ros2_control::Ros2Control" />

        <!-- Four ultrasonic-style proximity sensors - see simulation.wbt's
             extensionSlot for the real DistanceSensor node definitions
             these bind to by device name (reference="sonar_*" must match
             each DistanceSensor node's own "name" field exactly). -->
        <device reference="sonar_front" type="DistanceSensor">
            <ros>
                <enabled>true</enabled>
                <updateRate>20</updateRate>
                <topicName>ultrasonic/front</topicName>
                <alwaysOn>true</alwaysOn>
                <frameName>sonar_front</frameName>
            </ros>
        </device>
        <device reference="sonar_left" type="DistanceSensor">
            <ros>
                <enabled>true</enabled>
                <updateRate>20</updateRate>
                <topicName>ultrasonic/left</topicName>
                <alwaysOn>true</alwaysOn>
                <frameName>sonar_left</frameName>
            </ros>
        </device>
        <device reference="sonar_back" type="DistanceSensor">
            <ros>
                <enabled>true</enabled>
                <updateRate>20</updateRate>
                <topicName>ultrasonic/back</topicName>
                <alwaysOn>true</alwaysOn>
                <frameName>sonar_back</frameName>
            </ros>
        </device>
        <device reference="sonar_right" type="DistanceSensor">
            <ros>
                <enabled>true</enabled>
                <updateRate>20</updateRate>
                <topicName>ultrasonic/right</topicName>
                <alwaysOn>true</alwaysOn>
                <frameName>sonar_right</frameName>
            </ros>
        </device>
    </webots>

    <ros2_control name="WebotsControl" type="system">
        <hardware>
            <plugin>webots_ros2_control::Ros2ControlSystem</plugin>
        </hardware>
        <joint name="right wheel motor">
            <state_interface name="position"/>
            <command_interface name="velocity"/>
        </joint>
        <joint name="left wheel motor">
            <state_interface name="position"/>
            <command_interface name="velocity"/>
        </joint>
    </ros2_control>
</robot>
